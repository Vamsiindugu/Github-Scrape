/* Preview Screen Styles */
PreviewScreen {
    align: center middle;
}

#preview-container {
    width: 80%;
    height: 80%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#preview-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#preview-content {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}
